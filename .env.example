# Google Gemini (required)
GOOGLE_API_KEY=your_google_api_key
# If Gemini calls fail with "Connection refused", unset GOOGLE_GEMINI_BASE_URL in your shell

# Database — SQLite for fast local dev (default); Neon for shared/staging
DATABASE_URL=sqlite:///./aegis.db
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional alternative LLM providers (per-node model selection on the canvas).
# When a key is set, that provider's models appear in the node model picker and
# satisfy run gating. A credential bound on the node (Settings → Credentials)
# overrides these env fallbacks.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_AI_API_KEY=
OPENROUTER_API_KEY=
FEATHERLESS_API_KEY=
AI_GATEWAY_API_KEY=    # Vercel AI Gateway
# Operator-configured endpoints (custom apiBase is rejected on nodes and
# credentials — a non-default endpoint must be set here to take effect).
#OPENAI_API_BASE=
#ANTHROPIC_API_BASE=
#FIREWORKS_API_BASE=
#OPENROUTER_API_BASE=
#FEATHERLESS_API_BASE=
#VERCEL_API_BASE=
#OLLAMA_API_BASE=http://localhost:11434

# Optional search providers
EXA_API_KEY=your_exa_api_key

# Defaults
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MAX_CONCURRENT_RUNS=5
# Set production to block LLM-based guardrails when their judge key is unavailable.
DEPLOYMENT_ENVIRONMENT=development

# Auth (optional — disabled by default for local dev)
AUTH_ENABLED=false
AEGIS_API_KEY=your-secret-api-key

# Credential secret encryption at rest (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, integration secrets are stored in plaintext with a startup warning.
APP_ENCRYPTION_KEY=

# OpenTelemetry tracing (optional — export to Jaeger, LangFuse OTLP, Datadog, etc.)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aegis
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
# Comma-separated key=value pairs for auth headers (e.g. LangFuse public/secret keys)
OTEL_EXPORTER_HEADERS=
# Jaeger UI base URL for trace links in the dashboard (use {trace_id} placeholder if needed)
OTEL_UI_BASE_URL=http://localhost:16686
OTEL_SAMPLE_RATE=1.0
OTEL_NODE_SPANS=true

# LangFuse via OTLP (example — use your project keys from LangFuse settings)
# OTEL_ENABLED=true
# OTEL_EXPORTER_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_HEADERS=Authorization=Basic base64(public-key:secret-key)

# LangSmith tracing (OTLP/HTTP export of every run + standalone model call).
# Base URL only (self-hosted: https://<host>/api/v1; regional SaaS: eu./aws./apac. api.smith.langchain.com).
# Metadata-only by default: prompts, outputs, tool args, retrieved text and error
# messages are stripped from the export unless LANGSMITH_CAPTURE_CONTENT=true.
# Keep the API key in your secret store / local .env only.
LANGSMITH_ENABLED=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=aegis
LANGSMITH_API_KEY=
LANGSMITH_CAPTURE_CONTENT=false

# Presidio entity-based PII detection (requires: pip install presidio-analyzer presidio-anonymizer)
# python -m spacy download en_core_web_sm
PRESIDIO_ENABLED=false

# Run execution: inline (default) or worker (API enqueues, worker process executes)
RUN_EXECUTION_MODE=inline
RUN_WORKER_POLL_SECONDS=2

# Human-approval gate: how long a run may wait, paused, for an approve/deny decision
APPROVAL_TIMEOUT_SECONDS=3600

# Durable runs (Phase 2): resume interrupted runs from run_checkpoints on boot
# instead of failing them; bound the resume loop before failing for good.
RESUME_RUNS_ON_BOOT=true
RESUME_MAX_ATTEMPTS=3
# Cross-process event transport (Postgres LISTEN/NOTIFY + run_events replay).
# No-op on SQLite dev/test. Poll is the missed-notify safety net.
EVENT_BUS_NOTIFY_ENABLED=true
EVENT_BUS_POLL_SECONDS=30

# Rate limiting (when AUTH_ENABLED=true)
RATE_LIMIT_PER_MINUTE=120

# Data retention (disabled by default)
RETENTION_ENABLED=false
RUN_RETENTION_DAYS=90

# Async quality sampling for runs without inline eval nodes. 0 disables it.
ONLINE_EVAL_SAMPLE_RATE=0.05

# Pgvector retrieval (PostgreSQL + CREATE EXTENSION vector)
PGVECTOR_ENABLED=false
# Vector index for knowledge retrieval: auto (pgvector on Postgres, else
# sqlite-vec on SQLite, else JSON fallback) | pgvector | sqlite_vec | none.
VECTOR_STORE=auto

# MCP clients: stdio launches trusted host processes (off by default).
MCP_STDIO_ENABLED=false
# Exact comma-separated hostnames/IPs trusted for local/private HTTP MCP servers.
# Public HTTP endpoints remain subject to DNS pinning and redirect rejection.
MCP_ALLOWED_HOSTS=
MCP_TIMEOUT_SECONDS=30